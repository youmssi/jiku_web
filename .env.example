# ─── Jikū Frontend — environment variables ────────────────────────────────────
#
# Copy this file to .env and adjust as needed. The real .env is never committed.
#
# LOCAL DEVELOPMENT: a fresh clone runs with NO .env — the defaults below point
# at the local backend (http://localhost:8080).
#
# REAL DEPLOYMENTS (Vercel, on-premise): set everything in the REQUIRED
# section; OPTIONAL entries enable individual features and are safe to omit.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time —
# changing one requires a redeploy, and the value is publicly visible.
# Variables without the prefix are server-only (Server Actions / BFF).
# ──────────────────────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════════════════════
# REQUIRED — every real deployment must set all of these
# ══════════════════════════════════════════════════════════════════════════════

# Public site URL used for SEO metadata (canonical, Open Graph), sitemap, and
# robots.txt. Set to the production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API base URL exposed to the browser (client-side calls). Must include
# the backend's API prefix (SERVER_API_PREFIX, default /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Backend API base URL used server-side (Server Actions / BFF). Falls back to
# NEXT_PUBLIC_API_URL or localhost if unset. No NEXT_PUBLIC_ prefix: server only.
API_BASE_URL=http://localhost:8080/api/v1

# Support contact shown by the organizer Help button. Point at a monitored
# mailbox (the code falls back to support@jiku.app, which is not yours).
NEXT_PUBLIC_SUPPORT_EMAIL=support@jiku.app

# Authentication note: the backend returns JWTs in the response body; this
# frontend (BFF) stores them in httpOnly cookies and forwards the access token
# as a Bearer credential when calling the backend server-side. No auth secrets
# live in the frontend.


# ══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — feature toggles; each feature stays hidden/disabled when unset
# ══════════════════════════════════════════════════════════════════════════════

# WhatsApp support contact in international format (Help button). Hidden when
# unset.
# NEXT_PUBLIC_SUPPORT_WHATSAPP=+225XXXXXXXXXX

# Sales mailbox for enterprise / on-premise inquiries (landing pricing CTA).
# Falls back to NEXT_PUBLIC_SUPPORT_EMAIL when unset.
# NEXT_PUBLIC_SALES_EMAIL=sales@jiku.app

# Google sign-in (JIKU-51/52): OAuth client id of the Google Identity Services
# button (Google Cloud Console -> Credentials -> OAuth 2.0 Client ID, type
# "Web application"; add the site origin to "Authorized JavaScript origins").
# Must be the SAME value as the backend's GOOGLE_OAUTH_CLIENT_ID: this side
# obtains the ID token, the backend verifies its audience. Unset hides the
# button entirely.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Error tracking (JIKU-70). The DSN is public because capture runs in the browser
# too. With no DSN, captured errors are logged and nothing leaves the process.
# NEXT_PUBLIC_ERROR_TRACKING_RELEASE must be the same value the backend publishes
# as ERROR_TRACKING_RELEASE for that deployment, so a frontend report and the
# backend event for the same request line up. Reports from an API failure also
# carry the backend's X-Request-Id as the per-request join key.
# NEXT_PUBLIC_ERROR_TRACKING_DSN=
# NEXT_PUBLIC_ERROR_TRACKING_RELEASE=
# NEXT_PUBLIC_ERROR_TRACKING_ENVIRONMENT=production
#
# Source maps are uploaded at build time only when SENTRY_AUTH_TOKEN is set, so
# an ordinary local or CI build needs no credentials. Set it in the deployment
# environment to get readable stack traces.
# SENTRY_AUTH_TOKEN=

# Optional collector the frontend posts error reports to (navigator.sendBeacon).
# Independent of the DSN above; leave unset to keep reports console-only.
# NEXT_PUBLIC_ERROR_BEACON_URL=

# Self-hosted Umami analytics (JIKU-59): the tracking script URL and the site's
# website id from the Umami dashboard. Both unset skips loading the script
# entirely — safe before Umami itself is deployed (JIKU-60).
# NEXT_PUBLIC_UMAMI_SRC=https://analytics.jiku.mrvin100.de/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# ─── Google Search Console (all optional) ─────────────────────────────────────
# Site ownership verification token (Search Console -> Settings -> Ownership
# verification -> HTML tag; paste only the content value). Rendered as a
# <meta name="google-site-verification"> tag on every page. NOT needed when the
# domain is already verified at the DNS level (domain property) — subdomains
# inherit that verification.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Search Console API access (server-only). Create a Google Cloud service
# account, enable the "Google Search Console API", add the service account
# email as a full user of the property in Search Console, then set the
# credentials below. Used by lib/google-search-console.ts (sitemap submission,
# URL inspection). The private key is the PEM string from the JSON key file;
# keep the literal \n escapes when storing it on one line.
# GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# Property identifier: a URL-prefix property ("https://example.com/") or a
# domain property ("sc-domain:example.com"). Defaults to NEXT_PUBLIC_SITE_URL
# when unset — which only matches a URL-prefix property.
# GOOGLE_SEARCH_CONSOLE_SITE_URL=
