# Backend API base URL exposed to the browser (client-side calls).
# Public site URL used for SEO metadata, sitemap, and robots.txt.
# Set this to your production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Backend API base URL used server-side (Server Actions / BFF). Falls back to
# NEXT_PUBLIC_API_URL or localhost if unset. No NEXT_PUBLIC_ prefix: server only.
API_BASE_URL=http://localhost:8080/api/v1

# Authentication
# The backend returns JWTs in the response body; this frontend (BFF) stores them
# in httpOnly cookies and forwards the access token as a Bearer credential when
# calling the backend server-side. No auth secrets live in the frontend.

# Support contact (organizer Help button). Point these at a monitored mailbox and
# (optionally) a WhatsApp Business number in international format. WhatsApp is
# hidden when left unset.
NEXT_PUBLIC_SUPPORT_EMAIL=support@jiku.app
# NEXT_PUBLIC_SUPPORT_WHATSAPP=+225XXXXXXXXXX

# Sales mailbox for enterprise / on-premise inquiries (landing pricing CTA).
# Falls back to NEXT_PUBLIC_SUPPORT_EMAIL when unset.
# NEXT_PUBLIC_SALES_EMAIL=sales@jiku.app

# Error tracking DSN (public — capture runs in the browser too). No provider SDK
# is wired yet; until one is, captured errors are logged to the console. Set this
# once the provider is chosen.
# NEXT_PUBLIC_ERROR_TRACKING_DSN=

# ─── Google Search Console ────────────────────────────────────────────────────
# Site ownership verification token (Search Console → Settings → Ownership
# verification → HTML tag; paste only the content value). Rendered as a
# <meta name="google-site-verification"> tag on every page. Public by nature.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Search Console API access (server-only, optional). Create a Google Cloud
# service account, enable the "Google Search Console API", add the service
# account email as a full user of the property in Search Console, then set the
# credentials below. Used by lib/google-search-console.ts (sitemap submission,
# URL inspection). The private key is the PEM string from the JSON key file;
# keep the literal \n escapes when storing it on one line.
# GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
# GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# Property identifier: a URL-prefix property ("https://jiku.app/") or a domain
# property ("sc-domain:jiku.app"). Defaults to NEXT_PUBLIC_SITE_URL when unset.
# GOOGLE_SEARCH_CONSOLE_SITE_URL=
