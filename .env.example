# Backend API base URL exposed to the browser (client-side calls).
# NEXT_PUBLIC_* values are inlined into the client bundle at build time — when
# building the container image (see Dockerfile) pass them as --build-arg, not as
# runtime environment variables.
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1

# Backend API base URL used server-side (Server Actions / BFF). Falls back to
# NEXT_PUBLIC_API_URL or localhost if unset. No NEXT_PUBLIC_ prefix: server only.
API_BASE_URL=http://localhost:8080/api/v1

# Authentication
# The backend returns JWTs in the response body; this frontend (BFF) stores them
# in httpOnly cookies and forwards the access token as a Bearer credential when
# calling the backend server-side. No auth secrets live in the frontend.

# Support contact (organizer Help button). Point these at a monitored mailbox and
# (optionally) a WhatsApp Business number in international format. WhatsApp is
# hidden when left unset.
NEXT_PUBLIC_SUPPORT_EMAIL=support@jiku.app
# NEXT_PUBLIC_SUPPORT_WHATSAPP=+225XXXXXXXXXX
